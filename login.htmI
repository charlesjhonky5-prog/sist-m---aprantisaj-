<!DOCTYPE html>
<html lang="ht">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Sistèm Aprantisaj</title>

  <style>
    *{
      box-sizing:border-box;
      margin:0;
      padding:0;
      font-family:Arial,sans-serif;
    }

    body{
      min-height:100vh;
      background:#f4f6f8;
      color:#1f2937;
    }

    /* LOADING */
    #loading{
      position:fixed;
      inset:0;
      background:#ffffff;
      display:flex;
      align-items:center;
      justify-content:center;
      z-index:9999;
      font-size:20px;
      font-weight:bold;
      color:#2563eb;
    }

    /* LOGIN */
    #loginScreen{
      min-height:100vh;
      display:none;
      align-items:center;
      justify-content:center;
      padding:20px;
      background:linear-gradient(135deg,#2563eb,#1d4ed8);
    }

    .loginBox{
      width:100%;
      max-width:420px;
      background:white;
      border-radius:18px;
      padding:30px;
      box-shadow:0 20px 50px rgba(0,0,0,.20);
    }

    .loginBox h1{
      text-align:center;
      margin-bottom:10px;
      color:#1e3a8a;
    }

    .loginBox p{
      text-align:center;
      color:#64748b;
      margin-bottom:25px;
    }

    .inputGroup{
      margin-bottom:15px;
    }

    .inputGroup label{
      display:block;
      margin-bottom:6px;
      font-weight:bold;
    }

    .inputGroup input{
      width:100%;
      padding:13px;
      border:1px solid #cbd5e1;
      border-radius:10px;
      font-size:16px;
    }

    .btn{
      width:100%;
      padding:13px;
      border:0;
      border-radius:10px;
      font-size:16px;
      font-weight:bold;
      cursor:pointer;
      margin-top:10px;
    }

    .btnGoogle{
      background:#ffffff;
      border:1px solid #cbd5e1;
      color:#111827;
    }

    .btnGoogle:hover{
      background:#f8fafc;
    }

    .btnEmail{
      background:#2563eb;
      color:white;
    }

    .btnLogout{
      background:#dc2626;
      color:white;
      width:auto;
      padding:10px 16px;
      margin:0;
    }

    #message{
      margin-top:15px;
      padding:10px;
      border-radius:8px;
      text-align:center;
      display:none;
      white-space:pre-line;
    }

    .success{
      background:#dcfce7;
      color:#166534;
      display:block !important;
    }

    .error{
      background:#fee2e2;
      color:#991b1b;
      display:block !important;
    }

    .info{
      background:#dbeafe;
      color:#1e40af;
      display:block !important;
    }

    /* APP */
    #app{
      display:none;
      min-height:100vh;
    }

    header{
      background:#2563eb;
      color:white;
      padding:15px 20px;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:15px;
      flex-wrap:wrap;
    }

    header h1{
      font-size:22px;
    }

    .userInfo{
      display:flex;
      align-items:center;
      gap:12px;
      flex-wrap:wrap;
    }

    .userInfo span{
      font-size:14px;
    }

    main{
      max-width:1000px;
      margin:auto;
      padding:25px 15px;
    }

    .welcome{
      background:white;
      border-radius:15px;
      padding:25px;
      box-shadow:0 5px 20px rgba(0,0,0,.08);
    }

    .welcome h2{
      color:#1e3a8a;
      margin-bottom:12px;
    }

    .status{
      margin-top:20px;
      padding:15px;
      background:#dcfce7;
      color:#166534;
      border-radius:10px;
      font-weight:bold;
    }

    footer{
      text-align:center;
      padding:20px;
      color:#64748b;
    }

    @media(max-width:600px){
      header{
        flex-direction:column;
        align-items:flex-start;
      }

      .userInfo{
        width:100%;
        justify-content:space-between;
      }

      .loginBox{
        padding:22px;
      }
    }
  </style>
</head>

<body>

  <!-- LOADING -->
  <div id="loading">
    Chaje Sistèm Aprantisaj...
  </div>


  <!-- LOGIN -->
  <div id="loginScreen">

    <div class="loginBox">

      <h1>📚 Sistèm Aprantisaj</h1>

      <p>Konekte pou antre nan sistèm nan</p>

      <div class="inputGroup">
        <label>Email</label>
        <input
          id="email"
          type="email"
          placeholder="Email ou"
        >
      </div>

      <div class="inputGroup">
        <label>Modpas</label>
        <input
          id="password"
          type="password"
          placeholder="Modpas ou"
        >
      </div>

      <button
        class="btn btnEmail"
        onclick="loginEmail()"
      >
        Konekte ak Email
      </button>

      <button
        class="btn btnGoogle"
        id="googleButton"
        onclick="loginGoogle()"
      >
        🔵 Konekte ak Google
      </button>

      <div id="message"></div>

    </div>

  </div>


  <!-- APPLICATION -->
  <div id="app">

    <header>

      <h1>📚 Sistèm Aprantisaj</h1>

      <div class="userInfo">

        <span id="userEmail"></span>

        <button
          class="btn btnLogout"
          onclick="logout()"
        >
          Déconnexion
        </button>

      </div>

    </header>


    <main>

      <div class="welcome">

        <h2>Byenveni nan Sistèm Aprantisaj</h2>

        <p>
          Koneksyon Firebase la mache.
        </p>

        <div class="status">
          ✅ Kont Google la konekte avèk siksè.
        </div>

      </div>

    </main>


    <footer>
      © 2026 - Sistèm Aprantisaj
    </footer>

  </div>


  <!-- FIREBASE -->
  <script type="module">

    import { initializeApp }
      from "https://www.gstatic.com/firebasejs/12.2.1/firebase-app.js";

    import {
      getAuth,
      GoogleAuthProvider,
      signInWithPopup,
      signInWithRedirect,
      getRedirectResult,
      onAuthStateChanged,
      signOut,
      signInWithEmailAndPassword
    }
      from "https://www.gstatic.com/firebasejs/12.2.1/firebase-auth.js";


    /* =========================
       FIREBASE CONFIG
    ========================= */

    const firebaseConfig = {
      apiKey: "AIzaSyAufCl8gDfygwo2Mcxyede496L9Ysq2_DQ",
      authDomain: "sistem-aprantisaj-rapid.firebaseapp.com",
      projectId: "sistem-aprantisaj-rapid",
      storageBucket: "sistem-aprantisaj-rapid.firebasestorage.app",
      messagingSenderId: "369863005137",
      appId: "1:369863005137:web:a78f295285144be19b46f0",
      measurementId: "G-4FLZ95YX2F"
    };


    /* =========================
       INITIALIZE FIREBASE
    ========================= */

    const firebaseApp = initializeApp(firebaseConfig);

    const auth = getAuth(firebaseApp);

    const googleProvider = new GoogleAuthProvider();

    googleProvider.setCustomParameters({
      prompt:"select_account"
    });


    let currentUser = null;


    /* =========================
       MESSAGE
    ========================= */

    function showMessage(text,type="info"){

      const box = document.getElementById("message");

      box.textContent = text;

      box.className = "";

      box.id = "message";

      if(type === "success"){
        box.classList.add("success");
      }

      if(type === "error"){
        box.classList.add("error");
      }

      if(type === "info"){
        box.classList.add("info");
      }
    }


    /* =========================
       ERROR FIREBASE
    ========================= */

    function firebaseError(error){

      console.error("Firebase error:",error);

      const code = error?.code || "unknown";

      const message = error?.message || "Erè enkoni.";

      return (
        "Firebase bay yon erè.\n\n"+
        "Kòd: "+code+
        "\n\n"+
        "Mesaj: "+message
      );
    }


    /* =========================
       EMAIL LOGIN
    ========================= */

    window.loginEmail = async function(){

      const email =
        document.getElementById("email").value.trim();

      const password =
        document.getElementById("password").value;


      if(!email || !password){

        showMessage(
          "Tanpri mete email ak modpas ou.",
          "error"
        );

        return;
      }


      try{

        showMessage(
          "Koneksyon an ap fèt...",
          "info"
        );


        await signInWithEmailAndPassword(
          auth,
          email,
          password
        );


      }catch(error){

        showMessage(
          firebaseError(error),
          "error"
        );

      }

    };


    /* =========================
       GOOGLE LOGIN
    ========================= */

    window.loginGoogle = async function(){

      const button =
        document.getElementById("googleButton");


      try{

        button.disabled = true;

        button.textContent =
          "⏳ Koneksyon Google...";


        showMessage(
          "Koneksyon Google la ap fèt...",
          "info"
        );


        /*
          Sou telefòn Android,
          nou itilize Redirect dirèkteman.
          Sa evite popup ki ka rete ap tann.
        */

        const mobile =
          /Android|iPhone|iPad|iPod/i.test(
            navigator.userAgent
          );


        if(mobile){

          showMessage(
            "N ap louvri Google pou koneksyon an...",
            "info"
          );

          await signInWithRedirect(
            auth,
            googleProvider
          );

          return;
        }


        /*
          Sou òdinatè:
          eseye Popup.
        */

        await signInWithPopup(
          auth,
          googleProvider
        );


      }catch(error){

        console.error(
          "Google login error:",
          error
        );


        const redirectErrors = [

          "auth/popup-blocked",

          "auth/popup-closed-by-user",

          "auth/cancelled-popup-request",

          "auth/operation-not-supported-in-this-environment"

        ];


        if(
          redirectErrors.includes(error.code)
        ){

          try{

            showMessage(
              "Popup la pa disponib. N ap itilize Redirect...",
              "info"
            );


            await signInWithRedirect(
              auth,
              googleProvider
            );


            return;


          }catch(redirectError){

            showMessage(
              firebaseError(redirectError),
              "error"
            );

          }

        }else{

          showMessage(
            firebaseError(error),
            "error"
          );

        }


        button.disabled = false;

        button.textContent =
          "🔵 Konekte ak Google";

      }

    };


    /* =========================
       REDIRECT RESULT
    ========================= */

    getRedirectResult(auth)

      .then(result => {

        if(result && result.user){

          console.log(
            "Google Redirect OK:",
            result.user.email
          );

          console.log(
            "Google UID:",
            result.user.uid
          );

        }

      })

      .catch(error => {

        console.error(
          "Redirect result error:",
          error
        );

        showMessage(
          firebaseError(error),
          "error"
        );

      });


    /* =========================
       AUTH STATE
    ========================= */

    onAuthStateChanged(
      auth,
      async user => {

        try{

          if(!user){

            currentUser = null;

            document.getElementById(
              "loading"
            ).style.display = "none";


            document.getElementById(
              "app"
            ).style.display = "none";


            document.getElementById(
              "loginScreen"
            ).style.display = "flex";


            return;
          }


          /*
            PA GEN ADMIN / APPROVAL
            NAN ETAP SA A.

            Nenpòt kont ki autentifye
            antre dirèkteman.
          */

          currentUser = user;


          console.log(
            "USER:",
            user.email
          );

          console.log(
            "UID:",
            user.uid
          );


          document.getElementById(
            "loading"
          ).style.display = "none";


          document.getElementById(
            "loginScreen"
          ).style.display = "none";


          document.getElementById(
            "app"
          ).style.display = "block";


          document.getElementById(
            "userEmail"
          ).textContent =
            user.email || "";


        }catch(error){

          console.error(
            "AUTH ERROR:",
            error
          );


          document.getElementById(
            "loading"
          ).style.display = "none";


          document.getElementById(
            "loginScreen"
          ).style.display = "flex";


          showMessage(
            firebaseError(error),
            "error"
          );

        }

      }
    );


    /* =========================
       LOGOUT
    ========================= */

    window.logout = async function(){

      try{

        await signOut(auth);

      }catch(error){

        showMessage(
          firebaseError(error),
          "error"
        );

      }

    };

  </script>

</body>
</html>
